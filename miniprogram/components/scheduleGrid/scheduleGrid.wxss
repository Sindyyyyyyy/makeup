/* components/scheduleGrid - 从 pages/adminSlots/adminSlots.wxss 原样搬来
   自定义组件样式默认 styleIsolation: isolated，与宿主（后台首页）的
   .container / .btn-primary 同名类互不影响 */
.schedule-wrap {
  margin-bottom: 24rpx;
}

/* 周导航 */
.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(201, 91, 124, 0.08);
}
.nav-btn {
  color: #C95B7C;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  font-weight: 500;
}
.week-label {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 500;
}

/* 课程表 */
.schedule {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.row {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
}
.row:last-child { margin-bottom: 0; }
.header-row {
  border-bottom: 2rpx solid #F5E6EA;
  padding-bottom: 12rpx;
  margin-bottom: 16rpx;
}
.cell {
  flex: 1;
  text-align: center;
  padding: 4rpx;
  min-width: 0;
}
.time-label {
  flex: 1.3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #FFF0F4 0%, #FFE4EC 100%);
  border-radius: 16rpx;
  margin: 4rpx;
  padding: 16rpx 4rpx;
}
.slot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #C95B7C;
}
.slot-time {
  font-size: 20rpx;
  color: #B89C8A;
  margin-top: 4rpx;
}
.date-header {
  font-size: 22rpx;
  color: #666;
  padding: 8rpx 4rpx;
}
.date-header.past { color: #CCC; }
.dow { font-size: 22rpx; color: #999; }
.date { font-size: 26rpx; font-weight: 600; color: #4A4A4A; margin-top: 2rpx; }
.today-tag {
  background: #C95B7C;
  color: #FFF;
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  margin-top: 4rpx;
  display: inline-block;
}

.slot-cell {
  display: flex;
  align-items: stretch;
  padding: 4rpx;
}
.slot-btn {
  width: 100%;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  min-height: 60rpx;
  padding: 8rpx 4rpx;
  position: relative;
}
/* 这一天的时间被单独改过：右上角一个小钟，具体时间看弹窗 */
.time-flag {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  font-size: 20rpx;
  line-height: 1;
}
.slot-btn.open {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  color: #2E7D32;
  border: 2rpx solid #A5D6A7;
}
.slot-btn.booked {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  color: #F57F17;
  border: 2rpx solid #FFE082;
}
.slot-btn.closed {
  background: #F5F5F5;
  color: #BBB;
  border: 2rpx dashed #DDD;
}
.slot-btn.done {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  color: #1976D2;
  border: 2rpx solid #90CAF9;
}
/* 已过去的日期：和顾客端首页一致，置灰 + 虚线，排在最后以便覆盖 open/booked/closed */
.slot-btn.past {
  background: #FAFAFA;
  color: #CCC;
  border: 2rpx dashed #E8E8E8;
  font-size: 20rpx;
}
.style-count {
  font-size: 18rpx;
  opacity: 0.75;
  margin-top: 2rpx;
}
.loading-tip {
  text-align: center;
  color: #BBB;
  font-size: 24rpx;
  padding: 12rpx 0;
}

/* 妆造编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  background: #FFFFFF;
  width: 90%;
  max-width: 700rpx;
  max-height: 80vh;
  overflow-y: auto;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C95B7C;
  text-align: center;
}
.modal-sub {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin: 8rpx 0 24rpx;
}
.booked-tip {
  background: #FFF8E1;
  border: 2rpx solid #FFE082;
  color: #F57F17;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

/* 弹窗里的「改这一天的时间」 */
.time-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed #FFE0E8;
  margin-bottom: 16rpx;
}
.time-row-label {
  font-size: 26rpx;
  color: #666;
}
.time-row-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #C95B7C;
}
.time-row-flag {
  font-size: 20rpx;
  color: #F57F17;
  background: #FFF8E1;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}
.time-row-btn {
  margin-left: auto;
  font-size: 24rpx;
  color: #C95B7C;
  border: 2rpx solid #FFB6C8;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
.time-edit {
  background: #FFF8FA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.time-edit-pickers {
  display: flex;
  gap: 16rpx;
}
.time-picker {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #4A4A4A;
  background: #FFFFFF;
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
}
.time-edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.time-save,
.time-clear {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  border-radius: 28rpx;
  padding: 14rpx 0;
}
.time-save {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF;
}
.time-clear {
  background: #F5F5F5;
  color: #999;
}
.time-edit-hint {
  font-size: 20rpx;
  color: #AAA;
  margin-top: 12rpx;
  line-height: 1.5;
}
.quick-wrap {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #FFE0E8;
}
.quick-title {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.quick-btn {
  background: linear-gradient(135deg, #FFF0F4 0%, #FFE4EC 100%);
  border: 2rpx solid #FFB6C8;
  color: #C95B7C;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}
.quick-btn.disabled { opacity: 0.5; }
.quick-empty {
  font-size: 24rpx;
  color: #BBB;
  padding: 16rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
}
.style-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.style-name-input {
  flex: 2;
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  background: #FFF8FA;
}
.price-input-wrap {
  flex: 1.2;
  display: flex;
  align-items: center;
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 0 12rpx;
  background: #FFF8FA;
}
.yen {
  color: #C95B7C;
  font-size: 26rpx;
}
.style-price-input {
  flex: 1;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
}
.style-del {
  color: #C95B7C;
  font-size: 24rpx;
  padding: 8rpx;
}
.style-add {
  border: 2rpx dashed #FFB6C8;
  color: #C95B7C;
  border-radius: 12rpx;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
}
.modal-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}
.btn-secondary {
  flex: 1;
  background: #F5F5F5;
  color: #999 !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}
.btn-danger {
  flex: 1;
  background: #FFF0F4;
  color: #C95B7C !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}

/* 说明。默认收起只露两行（-webkit-line-clamp），点标题右边的三角展开。 */
.tips {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.tips-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C95B7C;
}
.tips-toggle {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border: 2rpx solid #FFE0E8;
  border-radius: 24rpx;
}
.tips-toggle-text {
  font-size: 22rpx;
  color: #C95B7C;
  margin-right: 6rpx;
}
.tips-arrow {
  font-size: 22rpx;
  color: #C95B7C;
  line-height: 1;
}
/* 正文：<text> 里的 \n 会渲染成换行，所以整段是一串文本行，
   line-clamp 按行截断（收起时只露两行并带省略号）。
   展开时改成 display:block 而不是 line-clamp:unset —— 各端对
   line-clamp 关键字的支持不一致，切 display 最稳。 */
.tips-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
}
.tips-text.collapsed {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.tips-text.expanded {
  display: block;
}
