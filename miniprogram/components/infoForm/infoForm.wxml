<!-- components/infoForm/infoForm.wxml - 个人信息表弹窗（个人中心与首页预约前共用） -->
<view wx:if="{{visible}}" class="modal-mask" bindtap="onClose">
  <view class="modal" catchtap="noop">

    <view class="modal-title">{{title}}</view>
    <view wx:if="{{hint}}" class="modal-hint">{{hint}}</view>
    <scroll-view scroll-y class="info-scroll">

      <view class="form-row">
        <text class="form-label">{{L.info.nickname}}</text>
        <!-- 与个人中心顶部共用同一字段，这里只读展示 -->
        <view class="form-static {{form.nickname ? '' : 'is-empty'}}">
          {{ form.nickname || L.info.nicknameMissing }}
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">{{L.info.gender}}</text>
        <view class="chip-group">
          <!-- item.value 是存进数据库的中文原值，item.label 是当前语言的显示文字 -->
          <view wx:for="{{genderOptions}}" wx:key="value"
                class="chip {{form.gender === item.value ? 'on' : ''}}"
                bindtap="onChipTap" data-group="gender" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">{{L.info.skinType}}</text>
        <view class="chip-group">
          <view wx:for="{{skinOptions}}" wx:key="value"
                class="chip {{form.skinType === item.value ? 'on' : ''}}"
                bindtap="onChipTap" data-group="skinType" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </view>

      <!-- ⚠️ 这里的 '敏感性' 是存库的中文原值，不能换成英文：换个值云函数的白名单就不认了 -->
      <view wx:if="{{form.skinType === '敏感性'}}" class="form-row">
        <text class="form-label">{{L.info.sensitiveLevel}}</text>
        <input class="form-input" value="{{form.sensitiveLevel}}" placeholder="{{L.info.sensitiveLevelPlaceholder}}"
               bindinput="onFormInput" data-field="sensitiveLevel" disabled="{{readonly}}" maxlength="50" />
      </view>

      <view class="form-row">
        <text class="form-label">{{L.info.hasAcne}}</text>
        <view class="chip-group">
          <view wx:for="{{yesNoOptions}}" wx:key="value"
                class="chip {{form.hasAcne === item.value ? 'on' : ''}}"
                bindtap="onChipTap" data-group="hasAcne" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">{{L.info.hasCosmeticSurgery}}</text>
        <view class="chip-group">
          <view wx:for="{{yesNoOptions}}" wx:key="value"
                class="chip {{form.hasCosmeticSurgery === item.value ? 'on' : ''}}"
                bindtap="onChipTap" data-group="hasCosmeticSurgery" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">{{L.info.hasAllergy}}</text>
        <view class="chip-group">
          <view wx:for="{{yesNoOptions}}" wx:key="value"
                class="chip {{form.hasAllergy === item.value ? 'on' : ''}}"
                bindtap="onChipTap" data-group="hasAllergy" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </view>

      <!-- ⚠️ 这里的 '有' 同样是存库的中文原值，不能换 -->
      <view wx:if="{{form.hasAllergy === '有'}}" class="form-row">
        <text class="form-label">{{L.info.allergyNote}}</text>
        <input class="form-input" value="{{form.allergyNote}}" placeholder="{{L.info.allergyNotePlaceholder}}"
               bindinput="onFormInput" data-field="allergyNote" disabled="{{readonly}}" maxlength="100" />
      </view>

      <view class="form-row form-row-col">
        <text class="form-label">{{L.info.photos}}{{requirePhoto && !readonly ? ' *' : ''}}{{L.info.photosOpen}}{{form.photos.length}}/{{maxPhotos}}{{L.info.photosClose}}</text>
        <view class="photo-grid">
          <view wx:for="{{form.photos}}" wx:key="*this" class="photo-item"
                bindtap="onPreviewPhoto" data-idx="{{index}}">
            <image class="photo-img" src="{{item}}" mode="aspectFill" />
            <view wx:if="{{!readonly}}" class="photo-del" catchtap="onDeletePhoto" data-idx="{{index}}">×</view>
          </view>
          <view wx:if="{{!readonly && form.photos.length < maxPhotos}}" class="photo-add" bindtap="onAddPhoto">
            <text class="photo-add-icon">＋</text>
            <text class="photo-add-text">{{form.photos.length}}/{{maxPhotos}}</text>
          </view>
        </view>
        <view wx:if="{{requirePhoto && !readonly && form.photos.length === 0}}" class="field-warn">
          {{L.info.photoRequired}}
        </view>
      </view>

      <!-- 想画的妆容照片（选填，最多 3 张）。
           属于「这一次预约」，不存进个人资料，所以每次预约都要重新传；
           在预约卡片的「详细信息」里改时，起点是这一单已存的图
           （styleRefSeed），可以像素颜照一样增删。 -->
      <view wx:if="{{showStyleRefs && !readonly}}" class="form-row form-row-col">
        <text class="form-label">{{L.info.styleRefs}}{{L.info.photosOpen}}{{styleRefPhotos.length}}/{{maxStyleRefPhotos}}{{L.info.photosClose}}</text>
        <view class="photo-grid">
          <view wx:for="{{styleRefPhotos}}" wx:key="*this" class="photo-item"
                bindtap="onPreviewStyleRef" data-idx="{{index}}">
            <image class="photo-img" src="{{item}}" mode="aspectFill" />
            <view class="photo-del" catchtap="onDeleteStyleRef" data-idx="{{index}}">×</view>
          </view>
          <view wx:if="{{styleRefPhotos.length < maxStyleRefPhotos}}" class="photo-add" bindtap="onAddStyleRef">
            <text class="photo-add-icon">＋</text>
            <text class="photo-add-text">{{styleRefPhotos.length}}/{{maxStyleRefPhotos}}</text>
          </view>
        </view>
        <view class="form-hint">{{L.info.styleRefsHint}}</view>
      </view>

      <!-- 只读展示：化妆师在「详细信息」里看顾客传的参考图（https 临时链接） -->
      <view wx:if="{{readonly && styleRefUrls.length}}" class="form-row form-row-col">
        <text class="form-label">{{L.info.styleRefs}}</text>
        <view class="photo-grid">
          <view wx:for="{{styleRefUrls}}" wx:key="*this" class="photo-item"
                bindtap="onPreviewStyleRef" data-idx="{{index}}">
            <image class="photo-img" src="{{item}}" mode="aspectFill" />
          </view>
        </view>
      </view>

    </scroll-view>

    <view wx:if="{{missingTip}}" class="missing-tip">{{missingTip}}</view>

    <view class="modal-buttons">
      <block wx:if="{{readonly}}">
        <button class="btn-secondary" bindtap="onClose">{{L.common.close}}</button>
      </block>
      <block wx:else>
        <button wx:if="{{showCancel}}" class="btn-secondary" bindtap="onClose">{{L.common.cancel}}</button>
        <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
          {{submitText}}
        </button>
      </block>
    </view>

  </view>
</view>
