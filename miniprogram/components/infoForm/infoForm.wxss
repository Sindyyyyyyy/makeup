/* components/infoForm/infoForm.wxss - 个人信息表弹窗（组件内自带样式，不依赖页面） */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 预约弹窗(z-index:100)之上 */
  z-index: 200;
}
.modal {
  background: #FFFFFF;
  width: 90%;
  max-width: 700rpx;
  max-height: 86vh;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C95B7C;
  text-align: center;
  flex-shrink: 0;
}
.modal-hint {
  font-size: 22rpx;
  color: #B89C8A;
  text-align: center;
  margin-top: 10rpx;
  flex-shrink: 0;
}
/* 字段多，主体可滚动，按钮固定在底部 */
.info-scroll {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
  margin: 20rpx 0;
}
.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.form-row-col {
  flex-direction: column;
  align-items: flex-start;
}
.form-label {
  width: 200rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  flex-shrink: 0;
}
.form-row-col .form-label {
  width: auto;
  margin-bottom: 16rpx;
}
.form-input {
  flex: 1;
  background: #FFF5F7;
  border: 2rpx solid #FFE0E8;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  height: auto;
}
/* 只读字段（昵称） */
.form-static {
  flex: 1;
  font-size: 26rpx;
  color: #4A4A4A;
  padding: 14rpx 0;
}
.form-static.is-empty {
  color: #B0A0A0;
  font-size: 24rpx;
}

/* 单选 chip */
.chip-group {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: #FFF5F7;
  border: 2rpx solid #FFE0E8;
  color: #8A7A80;
  font-size: 24rpx;
  line-height: 1.4;
}
.chip.on {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  border-color: transparent;
  color: #FFFFFF;
}

/* 素颜照 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
}
/* 可点开预览，给个按压反馈 */
.photo-item:active {
  opacity: 0.7;
}
.photo-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  display: block;
}
.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}
.photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #FFB6C8;
  background: #FFF8FA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.photo-add-icon {
  font-size: 48rpx;
  color: #E895A8;
  line-height: 1;
}
.photo-add-text {
  font-size: 20rpx;
  color: #B89C8A;
  margin-top: 8rpx;
}
.field-warn {
  font-size: 22rpx;
  color: #E08A9E;
  margin-top: 12rpx;
}
/* 选填项的说明文字（比 .field-warn 淡，因为不是错误提示） */
.form-hint {
  font-size: 22rpx;
  color: #B89C8A;
  margin-top: 12rpx;
}

/* 完整性提示 */
.missing-tip {
  font-size: 24rpx;
  color: #C9585B;
  background: #FFF0F0;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}
/* 两颗按钮必须完全一致：清掉 button 的默认 margin/上下 padding */
.modal-buttons button {
  margin: 0;
  padding: 0;
  line-height: 72rpx;
  height: 72rpx;
}
.modal-buttons .btn-primary,
.modal-buttons .btn-secondary {
  flex: 1;
}
.btn-primary {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn-secondary {
  background: #F5F5F5;
  color: #999 !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn-primary[disabled] {
  opacity: 0.6;
}