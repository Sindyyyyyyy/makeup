<view class="container">

  <!-- 登录表单已挪到独立页 pages/adminLogin（顾客点「化妆师入口」先进那里）。
       走到这里却没有令牌，只可能是令牌在子页（adminSlots/adminStyles）过期被清了，
       提示并把人送回登录页即可。 -->
  <block wx:if="{{!isAdmin}}">
    <view class="login-card">
      <view class="login-title">🌷 登录已失效</view>
      <view class="login-sub">请重新输入管理密码</view>
      <button class="btn-primary" bindtap="goLogin">去登录</button>
      <view class="hint">也可以到个人中心切回顾客端</view>
    </view>
  </block>

  <!-- 已登录：显示后台 -->
  <block wx:else>
    <view class="admin-header">
      <text class="admin-greet">胡鲁诺 下午好 ☀️</text>
      <text class="logout" bindtap="logout">退出</text>
    </view>

    <!-- 功能入口 -->
    <view class="entry-row two">
      <view class="entry-card" bindtap="goSlots">
        <text class="entry-icon">🌷</text>
        <view class="entry-text">
          <view class="entry-title">时间管理</view>
          <view class="entry-sub">设置上/下午/晚上时间</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-card" bindtap="goStyles">
        <text class="entry-icon">💄</text>
        <view class="entry-text">
          <view class="entry-title">妆容管理</view>
          <view class="entry-sub">常用妆造及价格</view>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <!-- 订阅消息：一次性订阅，每次点「开启」+1 条额度，额度会累积。
         新预约 / 取消 都靠它，顾客那边取消了才会用到，所以不点也没有副作用。 -->
    <view class="notify-row">
      <view class="notify-text">
        <view class="notify-title">🔔 新预约 / 取消提醒</view>
        <view class="notify-sub">{{notifyEnabled ? '额度已开启，用完可再点一次' : '开启后有人预约或取消时微信通知你'}}</view>
      </view>
      <view class="notify-btn" bindtap="enableNotify">{{notifyEnabled ? '再开启一次' : '开启'}}</view>
    </view>

    <!-- 课程表：直接开关时段 / 设妆造 / 看顾客详情 / 改某一天的时间，不必跳页。
         components/scheduleGrid 现在只有后台首页这一个宿主。
         「操作说明」原来挂在被改造成「时间管理」的时段管理页上，搬到这儿。 -->
    <schedule-grid id="scheduleGrid" show-tips="{{true}}" bind:authfail="handleAuthFail" />

    <!-- 统计 -->
    <view class="stats">
      <view class="stat-card">
        <view class="stat-num">{{stats.pending}}</view>
        <view class="stat-label">待确认</view>
      </view>
      <view class="stat-card">
        <view class="stat-num">{{stats.confirmed}}</view>
        <view class="stat-label">已确认</view>
      </view>
      <view class="stat-card">
        <view class="stat-num">{{stats.completed}}</view>
        <view class="stat-label">已完成</view>
      </view>
    </view>

    <!-- 筛选 -->
    <view class="filter">
      <view class="filter-label">筛选：</view>
      <view class="filter-tabs">
        <view class="tab {{filterStatus === 'all' ? 'active' : ''}}" data-status="all" bindtap="onFilter">全部</view>
        <view class="tab {{filterStatus === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="onFilter">待确认</view>
        <view class="tab {{filterStatus === 'confirmed' ? 'active' : ''}}" data-status="confirmed" bindtap="onFilter">已确认</view>
        <view class="tab {{filterStatus === 'completed' ? 'active' : ''}}" data-status="completed" bindtap="onFilter">已完成</view>
        <view class="tab {{filterStatus === 'rejected' ? 'active' : ''}}" data-status="rejected" bindtap="onFilter">已拒绝</view>
        <view class="tab {{filterStatus === 'cancelled' ? 'active' : ''}}" data-status="cancelled" bindtap="onFilter">已取消</view>
      </view>
    </view>

    <!-- 列表 -->
    <view class="booking-list">
      <view wx:if="{{filtered.length === 0}}" class="empty">
        暂无预约记录
      </view>
      <view wx:for="{{filtered}}" wx:key="_id" class="booking-card">
        <view class="bd-top">
          <text class="bd-date">{{item.date}} {{item.slotLabel}}</text>
          <text class="bd-status status-{{item.status}}">{{statusText[item.status]}}</text>
        </view>
        <view class="bd-info">昵称：{{item.name || '—'}}</view>
        <view wx:if="{{item.styleName}}" class="bd-info">妆造：{{item.styleName}} · ¥{{item.stylePrice}}</view>
        <view wx:if="{{item.remark}}" class="bd-note">备注：{{item.remark}}</view>
        <view class="bd-time">下单时间：{{item.createdAtText}}</view>

        <view wx:if="{{item.status === 'pending'}}" class="bd-actions">
          <button class="btn-detail" size="mini" data-booking-id="{{item._id}}" bindtap="openUserProfile">详细信息</button>
          <button class="btn-secondary" size="mini" data-id="{{item._id}}" data-action="reject" bindtap="doAction">拒绝</button>
          <button class="btn-primary" size="mini" data-id="{{item._id}}" data-action="confirm" bindtap="doAction">确认</button>
        </view>
        <view wx:if="{{item.status === 'confirmed'}}" class="bd-actions">
          <button class="btn-detail" size="mini" data-booking-id="{{item._id}}" bindtap="openUserProfile">详细信息</button>
          <button class="btn-primary" size="mini" data-id="{{item._id}}" data-action="complete" bindtap="doAction">标记完成</button>
        </view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">加载更多</view>
    <view wx:elif="{{bookings.length > 0}}" class="load-more tip">已加载全部</view>

    <view class="footer-tip">下拉可刷新 · 个人中心可切回顾客端</view>
  </block>
</view>

<!-- 顾客个人信息（只读）。lang="zh"：后台不参与翻译，这个弹窗必须是中文 -->
<info-form
  id="userProfileForm"
  visible="{{showUserProfile}}"
  info="{{userInfo}}"
  nickname="{{userNickname}}"
  style-ref-urls="{{userStyleRefUrls}}"
  title="顾客信息"
  hint="{{userInfoHint}}"
  readonly="{{true}}"
  lang="zh"
  bind:close="closeUserProfile"
/>
