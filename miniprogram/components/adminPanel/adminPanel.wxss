/* components/adminPanel/adminPanel.wxss - 化妆师后台 (温柔少女风) */
.container {
  padding: 24rpx;
  padding-bottom: 80rpx;
  min-height: 100vh;
}

/* 登录卡片 */
.login-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-top: 80rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}
.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 12rpx;
}
.login-sub {
  font-size: 26rpx;
  color: #B89C8A;
  margin-bottom: 32rpx;
}
.login-input {
  border: 2rpx solid #FFE0E8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  background: #FFF8FA;
  margin-bottom: 24rpx;
  text-align: center;
  letter-spacing: 4rpx;
}
.hint {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 24rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 32rpx;
  font-size: 30rpx;
  border: none;
}
.btn-primary[disabled] {
  background: #DDD;
  color: #999 !important;
}

/* 后台头部 */
.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.admin-greet {
  font-size: 32rpx;
  font-weight: 600;
  color: #C95B7C;
}
.logout {
  font-size: 24rpx;
  color: #B89C8A;
  padding: 8rpx 16rpx;
  border: 2rpx solid #F0E0E5;
  border-radius: 16rpx;
}

/* 功能入口 */
.entry-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.entry-card {
  flex: 1;
  background: linear-gradient(135deg, #FFE8EE 0%, #FFD4DE 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(201, 91, 124, 0.08);
}
.entry-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}
.entry-text {
  flex: 1;
  min-width: 0;
}
/* 两张入口卡片并排时收紧图标，避免文字被挤换行 */
.entry-row.two .entry-card { padding: 20rpx; }
.entry-row.two .entry-icon { font-size: 40rpx; margin-right: 10rpx; }
.entry-row.two .entry-arrow { display: none; }
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #C95B7C;
  display: block;
}
.entry-sub {
  font-size: 22rpx;
  color: #B89C8A;
  display: block;
  margin-top: 4rpx;
}
.entry-arrow {
  font-size: 40rpx;
  color: #C95B7C;
  font-weight: 300;
}

/* 统计 */
.stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #C95B7C;
  display: block;
}
.stat-label {
  font-size: 24rpx;
  color: #B89C8A;
  margin-top: 4rpx;
  display: block;
}

/* 筛选 */
.filter {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.filter-label {
  font-size: 26rpx;
  color: #999;
  margin-right: 16rpx;
}
.filter-tabs {
  display: flex;
  gap: 12rpx;
  flex: 1;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  color: #999;
  background: #F8F8F8;
  border-radius: 16rpx;
}
.tab.active {
  background: linear-gradient(135deg, #FFE0E8 0%, #FFD4DE 100%);
  color: #C95B7C;
  font-weight: 500;
}

/* 预约列表 */
.booking-list {
  display: flex;
  flex-direction: column;
}
.empty {
  text-align: center;
  color: #BBB;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.booking-card {
  background: #FFFFFF;
  border: 2rpx solid #FFE0E8;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.bd-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx dashed #F5E6EA;
}
.bd-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
}
.bd-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.bd-status.pending { background: #FFF3E0; color: #E89508; }
.bd-status.confirmed { background: #E8F5E9; color: #2E7D32; }
.bd-status.cancelled { background: #F5F5F5; color: #999; }
.bd-status.rejected { background: #FFEBEE; color: #C62828; }
.bd-status.completed { background: #E3F2FD; color: #1976D2; }
.bd-info {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.bd-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  background: #FFF8F9;
  padding: 12rpx;
  border-radius: 8rpx;
}
.bd-time {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 12rpx;
}
.bd-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.btn-secondary {
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  color: #999 !important;
  border-radius: 24rpx;
  font-size: 24rpx;
}
.btn-detail {
  background: #FFF0F4;
  border: 2rpx solid #FFB6C8;
  color: #C95B7C !important;
  border-radius: 24rpx;
  font-size: 24rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: none;
}

.load-more {
  text-align: center;
  font-size: 26rpx;
  color: #C95B7C;
  padding: 24rpx 0;
}
.load-more.tip {
  color: #BBB;
  font-size: 22rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 32rpx;
}
