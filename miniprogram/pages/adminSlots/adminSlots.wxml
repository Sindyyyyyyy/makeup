<view class="container">
  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="back-btn" bindtap="goBack">‹ 返回</view>
    <text class="page-title">时段管理</text>
    <view style="width:80rpx"></view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{!isAdmin}}" class="login-tip">
    <text>请先在「化妆师后台」登录后再管理时段</text>
  </view>

  <!-- 课程表（与化妆师后台首页共用同一份组件） -->
  <schedule-grid wx:if="{{isAdmin}}" id="scheduleGrid" show-tips="{{true}}" bind:authfail="handleAuthFail" />
</view>
