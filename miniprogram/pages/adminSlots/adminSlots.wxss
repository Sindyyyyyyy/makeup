/* pages/adminSlots/adminSlots.wxss - 时段管理页外壳（课程表样式在组件里） */
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.back-btn {
  color: #C95B7C;
  font-size: 28rpx;
  font-weight: 500;
  padding: 8rpx 0;
}
.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.login-tip {
  text-align: center;
  color: #BBB;
  font-size: 26rpx;
  padding: 40rpx 0;
}
