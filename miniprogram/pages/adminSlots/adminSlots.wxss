/* pages/adminSlots/adminSlots.wxss - 时段管理页 */
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.back-btn {
  color: #C95B7C;
  font-size: 28rpx;
  font-weight: 500;
  padding: 8rpx 0;
}
.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.login-tip {
  text-align: center;
  color: #BBB;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 周导航 */
.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(201, 91, 124, 0.08);
}
.nav-btn {
  color: #C95B7C;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  font-weight: 500;
}
.week-label {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 500;
}

/* 课程表 */
.schedule {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.row {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
}
.row:last-child { margin-bottom: 0; }
.header-row {
  border-bottom: 2rpx solid #F5E6EA;
  padding-bottom: 12rpx;
  margin-bottom: 16rpx;
}
.cell {
  flex: 1;
  text-align: center;
  padding: 4rpx;
  min-width: 0;
}
.time-label {
  flex: 1.3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #FFF0F4 0%, #FFE4EC 100%);
  border-radius: 16rpx;
  margin: 4rpx;
  padding: 16rpx 4rpx;
}
.slot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #C95B7C;
}
.slot-time {
  font-size: 20rpx;
  color: #B89C8A;
  margin-top: 4rpx;
}
.date-header {
  font-size: 22rpx;
  color: #666;
  padding: 8rpx 4rpx;
}
.date-header.past { color: #CCC; }
.dow { font-size: 22rpx; color: #999; }
.date { font-size: 26rpx; font-weight: 600; color: #4A4A4A; margin-top: 2rpx; }
.today-tag {
  background: #C95B7C;
  color: #FFF;
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  margin-top: 4rpx;
  display: inline-block;
}

.slot-cell {
  display: flex;
  align-items: stretch;
  padding: 4rpx;
}
.slot-btn {
  width: 100%;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  min-height: 60rpx;
  padding: 8rpx 4rpx;
}
.slot-btn.open {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  color: #2E7D32;
  border: 2rpx solid #A5D6A7;
}
.slot-btn.booked {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  color: #F57F17;
  border: 2rpx solid #FFE082;
}
.slot-btn.closed {
  background: #F5F5F5;
  color: #BBB;
  border: 2rpx dashed #DDD;
}

/* 说明 */
.tips {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 12rpx;
}
.tips-item {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.6;
}
