/* pages/index/index.wxss - 课程表主页 (温柔少女风) */
.container {
  padding: 24rpx;
  padding-bottom: 240rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin: 24rpx 0 16rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #C95B7C;
  display: block;
  letter-spacing: 2rpx;
}
.subtitle {
  font-size: 24rpx;
  color: #B89C8A;
  margin-top: 8rpx;
  display: block;
}

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #999;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
}
.dot-available { background: linear-gradient(135deg, #FFE8EE 0%, #FFD4DE 100%); border: 1rpx solid #FFB6C8; }
.dot-locked { background: #F0F0F0; border: 1rpx solid #DDD; }
.dot-taken { background: #E5E5E5; border: 1rpx solid #DDD; }
.dot-mine { background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%); }

/* 周导航 */
.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(201, 91, 124, 0.08);
}
.nav-btn {
  color: #C95B7C;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  font-weight: 500;
}
.week-label {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 500;
}

/* 课程表 */
.schedule {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.row {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
}
.row:last-child { margin-bottom: 0; }
.header-row {
  border-bottom: 2rpx solid #F5E6EA;
  padding-bottom: 12rpx;
  margin-bottom: 16rpx;
}
.cell {
  flex: 1;
  text-align: center;
  padding: 4rpx;
  min-width: 0;
}
.time-label {
  flex: 1.3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #FFF0F4 0%, #FFE4EC 100%);
  border-radius: 16rpx;
  margin: 4rpx;
  padding: 16rpx 4rpx;
}
.slot-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #C95B7C;
}
.slot-time {
  font-size: 20rpx;
  color: #B89C8A;
  margin-top: 4rpx;
}
.date-header {
  font-size: 22rpx;
  color: #666;
  padding: 8rpx 4rpx;
}
.date-header.past { color: #CCC; }
.dow { font-size: 22rpx; color: #999; }
.date { font-size: 26rpx; font-weight: 600; color: #4A4A4A; margin-top: 2rpx; }
.today-tag {
  background: #C95B7C;
  color: #FFF;
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  margin-top: 4rpx;
  display: inline-block;
}

.slot-cell {
  display: flex;
  align-items: stretch;
  padding: 4rpx;
}
.slot-btn {
  width: 100%;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  min-height: 60rpx;
}
/* 这一天的时间被单独改过：时间竖排两行显示在状态文字上方 */
.slot-btn.has-time {
  flex-direction: column;
  padding: 6rpx 0;
}
.cell-time {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  opacity: 0.85;
}
.slot-btn.available {
  background: linear-gradient(135deg, #FFE8EE 0%, #FFD4DE 100%);
  color: #C95B7C;
  border: 2rpx solid #FFB6C8;
}
.slot-btn.taken {
  background: #F5F5F5;
  color: #BBB;
  border: 2rpx solid #EEE;
}
.slot-btn.mine {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFF;
  border: 2rpx solid #C95B7C;
}
.slot-btn.past,
.slot-btn.expired {
  background: #FAFAFA;
  color: #CCC;
  border: 2rpx dashed #E8E8E8;
  font-size: 20rpx;
}
.slot-btn.locked {
  background: #F8F8F8;
  color: #AAA;
  border: 2rpx dashed #DDD;
  font-size: 20rpx;
}

/* 我的预约 */
.my-bookings {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 16rpx;
}
.empty {
  text-align: center;
  color: #BBB;
  padding: 48rpx 0;
  font-size: 26rpx;
}
.booking-card {
  border: 2rpx solid #FFE0E8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #FFFCFD;
}
.bd-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.bd-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
}
.bd-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.bd-status.pending { background: #FFF3E0; color: #E89508; }
.bd-status.confirmed { background: #E8F5E9; color: #2E7D32; }
.bd-status.cancelled { background: #F5F5F5; color: #999; }
.bd-status.rejected { background: #FFEBEE; color: #C62828; }
.bd-status.completed { background: #E3F2FD; color: #1976D2; }
.bd-info {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.bd-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  background: #FFF8F9;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}
.bd-actions {
  margin-top: 16rpx;
  text-align: right;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
/* 「注意事项」按钮：暖橙色描边，跟粉色主动作（详细信息/评价）和
   灰色取消按钮区分开 —— 它是「去看一眼」的辅助入口，不是改数据的动作 */
.btn-notice {
  background: #FFF8EE;
  border: 2rpx solid #FFD8A0;
  color: #C97B21;
  font-size: 24rpx;
}
.btn-detail {
  background: #FFF0F4;
  border: 2rpx solid #FFB6C8;
  color: #C95B7C;
  font-size: 24rpx;
}
.btn-cancel {
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  color: #999;
  font-size: 24rpx;
}
/* 评价按钮：和「详细信息」一样的粉色描边，它是主动作 */
.btn-review {
  background: #FFF0F4;
  border: 2rpx solid #FFB6C8;
  color: #C95B7C;
  font-size: 24rpx;
}

/* 评价弹窗里的正文输入框 */
.review-textarea {
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #FFF8FA;
  color: #4A4A4A;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  /* 原生组件的 placeholder 走原生绘制，white-space 未必被采纳；
     但普通输入框里的换行靠这条生效 */
  white-space: pre-line;
}
/* 提示语：普通 view（非原生组件），\n 能可靠换行 */
.review-hint {
  font-size: 22rpx;
  color: #BBB;
  line-height: 1.6;
  margin-top: 8rpx;
  white-space: pre-line;
}
.review-counter {
  text-align: right;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 8rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  background: #FFFFFF;
  width: 90%;
  max-width: 700rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 24rpx;
  text-align: center;
}
.form-row {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}
.form-input {
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #FFF8FA;
}
/* 昵称：只读展示，取自个人中心 */
.form-static {
  border: 2rpx dashed #FFE0E8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #FFF8FA;
  color: #4A4A4A;
}
.form-static.is-empty {
  color: #C0A8B0;
  font-size: 26rpx;
}

/* 妆造按钮组（dynamic 数量，CSS Grid 控制 1/2/3 列，超过 3 自动换行） */
.style-grid {
  margin-top: 4rpx;
}
.style-grid.grid-1 { display: grid; grid-template-columns: 1fr; gap: 16rpx; }
.style-grid.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.style-grid.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.style-grid.grid-0 { color: #BBB; font-size: 26rpx; padding: 16rpx; }

.style-btn {
  border: 2rpx solid #FFE0E8;
  background: #FFF8FA;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  text-align: center;
  transition: all .15s;
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.style-btn.on {
  background: linear-gradient(135deg, #FFE8EE 0%, #FFD4DE 100%);
  border: 2rpx solid #C95B7C;
  box-shadow: 0 2rpx 8rpx rgba(201, 91, 124, 0.18);
}
.style-btn.off {
  opacity: 0.4;
  background: #F5F5F5;
  border-style: dashed;
}
.style-icon {
  font-size: 40rpx;
  display: block;
}
.style-label {
  font-size: 24rpx;
  color: #4A4A4A;
  margin-top: 6rpx;
  display: block;
}
.style-btn.on .style-label {
  color: #C95B7C;
  font-weight: 600;
}

/* 价格预览 */
.price-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #FFF8F9;
  border-radius: 12rpx;
  border: 2rpx solid #FFE0E8;
  text-align: center;
}
.price-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #C95B7C;
}
.price-unit {
  font-size: 24rpx;
  color: #B89C8A;
}
.price-none {
  font-size: 26rpx;
  color: #B89C8A;
}

.modal-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn-secondary {
  flex: 1;
  background: #F5F5F5;
  color: #999 !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}

/* 预约成功 · 注意事项弹窗 */
.notice-mask {
  /* info-form 用了 200，本弹窗在它之上 */
  z-index: 300;
  padding: 32rpx 0;
}
.notice-modal {
  max-width: 620rpx;
}
.notice-subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 20rpx;
}
.notice-scroll {
  max-height: 52vh;
  border-radius: 12rpx;
  background: #FFF7FA;
}
/* 正在换临时链接：占位高度别塌掉，否则弹窗会跟着抖一下 */
.notice-loading {
  min-height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
}
/* 换链接失败：包内备用图 + 重新加载 */
.notice-error {
  padding-bottom: 8rpx;
}
.notice-error-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 34rpx;
}
.notice-retry {
  margin-top: 20rpx;
  background: #FFF0F4;
  border: 2rpx solid #FFB6C8;
  color: #C95B7C !important;
  border-radius: 32rpx;
  font-size: 26rpx;
  padding: 14rpx 0;
}
.notice-img {
  display: block;
  width: 100%;
  border-radius: 12rpx;
}
.notice-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
.notice-ok {
  margin-top: 24rpx;
}
