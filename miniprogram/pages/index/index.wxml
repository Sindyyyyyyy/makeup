<!-- 顾客预约（adminMode=false 时渲染）
     文案全部走 data.L（utils/i18n.js 的字典）：WXML 不能调用 JS 函数，
     所以语言切换只能靠整份字典进 data 后重渲染。 -->
<block wx:if="{{!adminMode}}">
<view class="container">
  <!-- 顶部欢迎区 -->
  <view class="header">
    <text class="title">{{L.index.title}}</text>
    <text class="subtitle">{{L.index.subtitle}}</text>
  </view>

  <!-- 周导航 -->
  <view class="week-nav">
    <view class="nav-btn" bindtap="prevWeek">{{L.index.prevWeek}}</view>
    <view class="week-label">{{weekRange}}</view>
    <view class="nav-btn" bindtap="nextWeek">{{L.index.nextWeek}}</view>
  </view>

  <!-- 图例 -->
  <view class="legend">
    <view class="legend-item">
      <view class="legend-dot dot-available"></view>
      <text>{{L.index.legendAvailable}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot dot-locked"></view>
      <text>{{L.index.legendLocked}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot dot-taken"></view>
      <text>{{L.index.legendTaken}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot dot-mine"></view>
      <text>{{L.index.legendMine}}</text>
    </view>
  </view>

  <!-- 课程表 -->
  <view class="schedule">
    <!-- 表头 -->
    <view class="row header-row">
      <view class="cell time-label"></view>
      <view wx:for="{{weekDates}}" wx:key="date" class="cell date-header {{item.isPast ? 'past' : ''}}">
        <!-- 星期几按 _idx（周一起 0..6）取字典，后台的 scheduleGrid 仍用 item.dow -->
        <view class="dow">{{L.dow[item._idx]}}</view>
        <view class="date">{{item.dateLabel}}</view>
        <view wx:if="{{item.isToday}}" class="today-tag">{{L.index.today}}</view>
      </view>
    </view>

    <!-- 时段行 -->
    <view wx:for="{{slots}}" wx:for-item="slot" wx:key="key" class="row slot-row">
      <view class="cell time-label">
        <!-- 时段名按 key 取字典，存库的 slot 值本来就是 morning/afternoon/evening -->
        <view class="slot-name">{{L.slot[slot.key]}}</view>
        <view class="slot-time">{{slot.time}}</view>
      </view>
      <view wx:for="{{weekDates}}" wx:for-item="date" wx:key="date" class="cell slot-cell">
        <block wx:if="{{grid[slot._idx][date._idx].status === 'available'}}">
          <view class="slot-btn available {{grid[slot._idx][date._idx].custom ? 'has-time' : ''}}"
                bindtap="onSlotTap"
                data-date="{{date.date}}" data-slot="{{slot.key}}"
                data-name="{{L.slot[slot.key]}}"
                data-time="{{grid[slot._idx][date._idx].time}}"
                data-status="available"
                data-styles="{{grid[slot._idx][date._idx].slotState.styles}}">
            <!-- 这一天的时间被化妆师单独改过时，把准时间竖排显示出来
                 （格子只有 67rpx 宽，'10:00-12:00' 横排不下） -->
            <block wx:if="{{grid[slot._idx][date._idx].custom}}">
              <text class="cell-time">{{grid[slot._idx][date._idx].tStart}}</text>
              <text class="cell-time">{{grid[slot._idx][date._idx].tEnd}}</text>
            </block>
            <text>{{L.index.slotAvailable}}</text>
          </view>
        </block>
        <block wx:elif="{{grid[slot._idx][date._idx].status === 'mine'}}">
          <view class="slot-btn mine">
            <text>{{L.index.slotMine}}</text>
          </view>
        </block>
        <block wx:elif="{{grid[slot._idx][date._idx].status === 'taken'}}">
          <view class="slot-btn taken">
            <text>{{L.index.slotTaken}}</text>
          </view>
        </block>
        <block wx:elif="{{grid[slot._idx][date._idx].status === 'expired'}}">
          <view class="slot-btn expired">
            <text>{{L.index.slotExpired}}</text>
          </view>
        </block>
        <block wx:elif="{{grid[slot._idx][date._idx].status === 'past'}}">
          <view class="slot-btn past">
            <text>{{L.index.slotPast}}</text>
          </view>
        </block>
        <block wx:else>
          <view class="slot-btn locked">
            <text>{{L.index.slotLocked}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 我的预约 -->
  <view class="my-bookings">
    <view class="section-title">{{L.index.myBookings}}</view>
    <view wx:if="{{myBookings.length === 0}}" class="empty">
      {{L.index.emptyBookings}}
    </view>
    <view wx:for="{{myBookings}}" wx:key="_id" class="booking-card">
      <view class="bd-top">
        <text class="bd-date">{{item.date}} {{item.slotLabel}}</text>
        <text class="bd-status status-{{item.status}}">{{L.status[item.status]}}</text>
      </view>
      <view class="bd-info">{{L.index.labelNickname}}{{item.name || '—'}}</view>
      <view wx:if="{{item.styleName}}" class="bd-info">{{L.index.labelStyle}}{{item.styleName}} · ¥{{item.stylePrice}}</view>
      <view wx:if="{{item.remark}}" class="bd-note">{{L.index.labelRemark}}{{item.remark}}</view>
      <view wx:if="{{item.status === 'pending' || item.status === 'confirmed'}}" class="bd-actions">
        <!-- 「注意事项」放在「详细信息」左边：顾客下单后那一下没长按保存图，
             还能从这张卡片里把注意事项图再弹出来一次 -->
        <button class="btn-notice" size="mini" bindtap="showNoticeTips">{{L.index.noticeBtn}}</button>
        <button class="btn-detail" size="mini" bindtap="openInfoDetail" data-id="{{item._id}}">{{L.index.detail}}</button>
        <button class="btn-cancel" size="mini" bindtap="cancelBooking" data-id="{{item._id}}">{{L.index.cancelBooking}}</button>
      </view>
      <!-- 已完成的单才给评价入口；评价过就变成「查看评价」（同一个弹窗，可改） -->
      <view wx:if="{{item.status === 'completed'}}" class="bd-actions">
        <button class="btn-review" size="mini" bindtap="openReview" data-id="{{item._id}}">
          {{item.hasReview ? L.index.viewReview : L.index.review}}
        </button>
      </view>
    </view>
  </view>
</view>

<!-- 预约弹窗 -->
<view wx:if="{{showModal}}" class="modal-mask" bindtap="closeModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{L.index.modalTitle}} {{modalInfo}}</view>

    <view class="form-row">
      <text class="form-label">{{L.index.formNickname}}</text>
      <!-- 昵称取自个人中心（users.nickname），与个人中心始终一致 -->
      <view class="form-static {{nickname ? '' : 'is-empty'}}">
        {{ nickname || L.index.nicknameMissing }}
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">{{L.index.selectStyle}}{{modalStyles.length > 0 ? ' *' : ''}}</text>
      <view wx:if="{{modalStyles.length === 0}}" class="style-grid grid-0">
        {{L.index.noStyleYet}}
      </view>
      <view wx:else class="style-grid grid-{{modalStyles.length > 3 ? 3 : modalStyles.length}}">
        <view wx:for="{{modalStyles}}" wx:key="name"
              class="style-btn {{selectedStyle === index ? 'on' : 'off'}}"
              bindtap="onSelectStyle" data-idx="{{index}}">
          <text class="style-label">{{item.name}}</text>
          <text class="price-none">¥{{item.price}}</text>
        </view>
      </view>
    </view>

    <view class="modal-buttons">
      <button class="btn-secondary" bindtap="closeModal">{{L.common.cancel}}</button>
      <button class="btn-primary" bindtap="submitBooking" loading="{{submitting}}">{{L.index.submitBooking}}</button>
    </view>
  </view>
</view>

<!-- 评价弹窗（只给「已完成」的预约）
     同一个弹窗兼两个用途：没评价过 → 写一条；评价过 → 看/改已有的。
     内容直接放在 textarea 里可编辑，不用额外的只读态。 -->
<view wx:if="{{showReview}}" class="modal-mask" bindtap="closeReview">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{L.index.reviewTitle}}</view>

    <view class="form-row">
      <text class="form-label">{{L.index.reviewBooking}}</text>
      <view class="form-static">{{reviewBookingLabel}}</view>
    </view>

    <view class="form-row">
      <text class="form-label">{{L.index.reviewContent}}</text>
      <textarea class="review-textarea" maxlength="200" value="{{reviewContent}}"
                placeholder="{{L.index.reviewPlaceholder}}" bindinput="onReviewInput"></textarea>
      <view class="review-hint">{{L.index.reviewHint}}</view>
      <view class="review-counter">{{reviewContent.length}}/200</view>
    </view>

    <view class="modal-buttons">
      <button class="btn-secondary" bindtap="closeReview">{{L.common.cancel}}</button>
      <button class="btn-primary" bindtap="submitReview" loading="{{reviewSubmitting}}">
        {{reviewExists ? L.index.reviewUpdateSubmit : L.index.reviewSubmit}}
      </button>
    </view>
  </view>
</view>

<!-- 个人信息表（与个人中心共用 info-form 组件）
     infoMode=confirm：提交预约前的确认，必须填完整才能继续下单
     infoMode=view：预约卡片上的“详细信息”，随时查看/更新，不卡完整性。
       这时弹窗里改的「想画的妆容照片」属于那一单（detailBookingId），
       不是个人资料 —— 参考图每次预约都要重新传，所以不存进 users.info。 -->
<info-form
  id="infoForm"
  visible="{{showInfo}}"
  info="{{info}}"
  nickname="{{nickname}}"
  title="{{infoMode === 'confirm' ? L.index.confirmTitle : L.index.detailTitle}}"
  hint="{{infoHint}}"
  require-complete="{{infoMode === 'confirm'}}"
  require-photo="{{infoMode === 'confirm'}}"
  show-style-refs="{{infoMode === 'confirm' || infoMode === 'view'}}"
  style-ref-seed="{{detailStyleRefs}}"
  submit-text="{{infoMode === 'confirm' ? L.index.confirmSubmit : L.index.saveSubmit}}"
  lang="{{lang}}"
  bind:close="closeInfo"
  bind:save="onSaveInfo"
/>

<!-- 预约成功 · 化妆注意事项
     show-menu-by-longpress 是长按保存到相册的关键：只有网络图片（云函数换来的 https
     临时链接）才生效，打包在包内的兜底图长按不会有菜单。scroll-view 限高，否则长图
     在小屏上根本看不全。
     两个入口共用这一个弹窗：刚下单成功（noticeSuccess=true，标题「预约成功」），
     以及从预约卡片上重新打开（noticeSuccess=false，标题「化妆注意事项」）。 -->
<view wx:if="{{showNotice}}" class="modal-mask notice-mask" bindtap="closeNotice">
  <view class="modal notice-modal" catchtap="noop">
    <view class="modal-title">{{noticeSuccess ? L.index.bookingSuccess : L.index.noticeTitle}}</view>
    <view class="notice-subtitle">{{L.index.noticeSubtitle}}</view>
    <scroll-view class="notice-scroll" scroll-y="true">
      <!-- 正在换临时链接：转圈，别让顾客对着一个白框等 -->
      <view wx:if="{{noticeLoading}}" class="notice-loading">{{L.common.loading}}</view>
      <!-- 换链接失败：给包内备用图（能看、但长按存不到相册）+ 重新加载 -->
      <view wx:elif="{{noticeError}}" class="notice-error">
        <image class="notice-img" src="/images/notice.jpg" mode="widthFix" />
        <view class="notice-error-tip">{{L.index.noticeFallbackTip}}</view>
        <button class="notice-retry" bindtap="retryNotice">{{L.index.noticeRetry}}</button>
      </view>
      <!-- 正常：https 临时链接，长按可保存到相册。binderror 是自愈入口 -->
      <image wx:elif="{{noticeImg}}" class="notice-img" src="{{noticeImg}}" mode="widthFix"
             show-menu-by-longpress="{{true}}" binderror="onNoticeImageError" />
    </scroll-view>
    <view class="notice-tip">{{noticeLoading || noticeError ? '' : L.index.noticeTip}}</view>
    <button class="btn-primary notice-ok" bindtap="closeNotice">{{L.index.noticeOk}}</button>
  </view>
</view>
</block>

<!-- 化妆师后台（adminMode=true 时渲染，与顾客端互斥）
     做成组件而不是独立页面，是为了底部「首页 / 个人中心」导航始终在。
     退出登录或令牌过期时组件会抛 modechange，宿主切回顾客端。 -->
<admin-panel wx:else id="adminPanel" active="{{adminMode ? 'admin' : 'customer'}}" bind:modechange="onModeChange" />
