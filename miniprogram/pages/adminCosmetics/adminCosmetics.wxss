/* pages/adminCosmetics/adminCosmetics.wxss - 化妆品管理页 */
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.back-btn {
  color: #C95B7C;
  font-size: 28rpx;
  font-weight: 500;
  padding: 8rpx 0;
}
.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.login-tip {
  text-align: center;
  color: #BBB;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* ============ 库存概览 ============ */
.summary {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.sum-main {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.sum-total {
  font-size: 48rpx;
  font-weight: 700;
  color: #C95B7C;
}
.sum-unit {
  font-size: 24rpx;
  color: #B89C8A;
  margin-left: 6rpx;
}
.sum-right {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.sum-item {
  font-size: 24rpx;
}
/* 零的时候淡化，免得「已过期 0」红红地杵在那儿吓人 */
.is-zero {
  color: #C9C9C9;
}
.is-expired {
  color: #C62828;
  font-weight: 600;
}
.is-soon {
  color: #E86A17;
  font-weight: 600;
}

/* ============ 筛选 ============ */
.filters {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-row {
  display: flex;
  align-items: center;
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 0 12rpx;
  background: #FFF8FA;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  padding: 16rpx 4rpx;
  font-size: 28rpx;
  height: auto;
}
.search-clear {
  color: #B0A0A0;
  font-size: 36rpx;
  line-height: 1;
  padding: 8rpx;
}

.chip-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
}
.chip-row {
  display: flex;
  flex-direction: row;
}
/* 换行版：用在表单里的妆造多选 */
.chip-row.wrap {
  flex-wrap: wrap;
  white-space: normal;
}
.chip {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
  background: #F8F8F8;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip.active {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.filter-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}
.groupby {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.filter-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}
.tab {
  font-size: 24rpx;
  color: #999;
  background: #F8F8F8;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin-right: 10rpx;
}
.tab.active {
  background: linear-gradient(135deg, #FFE0E8 0%, #FFD4DE 100%);
  color: #C95B7C;
  font-weight: 500;
}
.toggle {
  font-size: 24rpx;
  color: #999;
  background: #F8F8F8;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.toggle.on {
  background: linear-gradient(135deg, #FFE0E8 0%, #FFD4DE 100%);
  color: #C95B7C;
  font-weight: 500;
}
.filter-clear {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #C95B7C;
  text-align: center;
}

/* ============ 列表 ============ */
.cos-list {
  margin-bottom: 24rpx;
}
.empty {
  text-align: center;
  color: #BBB;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.group-header {
  font-size: 26rpx;
  font-weight: 600;
  color: #B89C8A;
  margin: 20rpx 4rpx 12rpx;
}
.cos-card {
  display: flex;
  background: #FFFFFF;
  border: 2rpx solid #FFE0E8;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
/* 用完的沉到列表底部，同时整行灰掉——不是「删掉」，只是不再是要紧的事 */
.cos-card.out {
  opacity: 0.45;
}

.cos-photo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #FFF5F7;
}
.cos-photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.cos-main {
  flex: 1;
  min-width: 0;
}

.cos-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.cos-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
  flex: 1;
  min-width: 0;
  /* 名字长的时候省略，别把右侧的效期标签挤下去 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.level-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}

.cos-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.cos-expiry {
  font-size: 24rpx;
  margin-top: 8rpx;
}
/* 效期文字跟着档位变色，和 level-tag 呼应 */
.lv-expired { color: #C62828; font-weight: 600; }
.lv-soon3 { color: #E86A17; }
.lv-soon6 { color: #B8860B; }
.lv-ok { color: #666; }
.lv-none { color: #B0A0A0; }

.cos-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.mini-tag {
  font-size: 20rpx;
  color: #C95B7C;
  background: #FFF0F4;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.cos-note {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  background: #FFF8F9;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
}

.cos-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
}
.qty {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.qty-text {
  font-size: 24rpx;
  color: #666;
}
.qty-out {
  color: #BBB;
}
.cos-ops {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 操作按钮（照 adminStyles 的 .op-btn 样式） */
.op-btn {
  color: #C95B7C;
  font-size: 24rpx;
  border: 2rpx solid #FFB6C8;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}
.op-btn.danger {
  color: #999;
  border-color: #EEE;
}
.op-btn.minus {
  margin-left: 16rpx;
  color: #666;
  border-color: #E0E0E0;
}

/* ============ 表单 ============ */
.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 20rpx;
}
.field {
  margin-bottom: 18rpx;
  flex: 1;
  min-width: 0;
}
.field.half {
  margin-bottom: 0;
}
.field-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.field-label {
  display: block;
  font-size: 24rpx;
  color: #B89C8A;
  margin-bottom: 8rpx;
}
.field-label i {
  color: #C95B7C;
  font-style: normal;
  margin-left: 4rpx;
}
.field-sub {
  display: block;
  font-size: 22rpx;
  color: #C9B8C0;
  margin-bottom: 8rpx;
}
.field-tip {
  font-size: 22rpx;
  color: #BBB;
  padding: 8rpx 0;
}
.form-input {
  border: 2rpx solid #FFE0E8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #FFF8FA;
  height: auto;
  box-sizing: border-box;
}
/* picker 包在 view 里，样式跟 input 对齐 */
.form-input.picker {
  min-height: 34rpx;
  line-height: 34rpx;
}
.form-input.placeholder {
  color: #C9B8C0;
}

.switch {
  display: flex;
  gap: 12rpx;
}
.switch-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
}
.switch-btn.active {
  background: linear-gradient(135deg, #FFE0E8 0%, #FFD4DE 100%);
  color: #C95B7C;
  font-weight: 500;
}
.switch-body {
  margin-top: 14rpx;
}
.form-hint {
  font-size: 22rpx;
  color: #B89C8A;
  margin-top: 12rpx;
  line-height: 1.5;
}

.photo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.photo-pick {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #FFB6C8;
  background: #FFF8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #C95B7C;
}
.photo-pick.has {
  border-style: solid;
  border-color: #FFE0E8;
}
.photo-del {
  font-size: 24rpx;
  color: #999;
}

.form-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 按钮 */
.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}
.btn-secondary {
  flex: 1;
  background: #F5F5F5;
  color: #999 !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}

/* 说明 */
.tips {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 12rpx;
}
.tips-item {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.6;
}
