/* pages/adminLogin/adminLogin.wxss - 化妆师登录页（温柔少女风，与后台一致） */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F4 0%, #FFF5F7 40%, #FFF5F7 100%);
}

/* 自定义导航栏：胶囊按钮在右上，左上角留给返回箭头 */
.custom-nav {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-btn {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-hover {
  opacity: 0.5;
}
.back-icon {
  font-size: 56rpx;
  color: #C95B7C;
  line-height: 1;
  /* 字体里的 ‹ 视觉上偏右，往左挪一点居中 */
  margin-left: -6rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #C95B7C;
}

/* 登录区 */
.login-body {
  padding: 120rpx 64rpx 0;
  text-align: center;
}

/* 静默确认身份的中间态。留在后台视图的化妆师通常一闪而过，
   不会闪的是普通顾客——他们根本没走到这个页面。 */
.checking {
  padding-top: 200rpx;
  font-size: 28rpx;
  color: #B89C8A;
}
.login-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 32rpx;
}
.login-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 12rpx;
}
.login-sub {
  font-size: 26rpx;
  color: #B89C8A;
  margin-bottom: 56rpx;
}
.login-input {
  border: 2rpx solid #FFE0E8;
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 34rpx;
  background: #FFFFFF;
  margin-bottom: 40rpx;
  text-align: center;
  letter-spacing: 8rpx;
}
.login-ph {
  letter-spacing: 0;
  color: #CCC;
  font-size: 28rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 40rpx;
  font-size: 32rpx;
  border: none;
  padding: 24rpx 0;
}
.btn-primary[disabled] {
  background: #E8CDD6;
  color: #FFF !important;
}

.back-tip {
  margin-top: 48rpx;
  font-size: 26rpx;
  color: #B89C8A;
  text-decoration: underline;
}
