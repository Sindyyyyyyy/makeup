<!-- pages/profile/profile.wxml - 个人中心 -->
<view class="container">

  <!-- 资料卡 -->
  <view class="card">
    <!-- 卡片头：左边标题，右边中/EN 切换。语言只能在顾客自己的手机上切，
         所以放在这里最显眼（不动导航栏，也就不会碰到右上角的系统胶囊按钮） -->
    <view class="card-head">
      <view class="card-title">{{L.profile.myProfile}}</view>
      <view class="lang-switch">
        <view class="lang-btn {{lang === 'zh' ? 'on' : ''}}" data-lang="zh" bindtap="onLangTap">中</view>
        <view class="lang-btn {{lang === 'en' ? 'on' : ''}}" data-lang="en" bindtap="onLangTap">EN</view>
      </view>
    </view>

    <!-- 首次进入（还没登录）：资料卡里只放一个「登录」按钮，
         头像和昵称都不显示。登录按钮本身就是 chooseAvatar 按钮——点它直接调起
         微信头像选择器，在弹层里选「微信头像」即授权头像；选完之后代码会自动
         聚焦下面的昵称输入框，键盘上方自带「使用微信昵称」，一点就完成昵称授权。
         ⚠️ 微信自 2022-10-25 收回了 wx.getUserProfile，一次授权拿不到「头像+昵称」
         两个字段，这是现行规则下唯一合规的「一键登录」写法。 -->
    <view wx:if="{{!loggedIn}}" class="login-block">
      <button class="btn-primary login-btn" open-type="chooseAvatar" bindchooseavatar="onLoginChooseAvatar"
              loading="{{uploading}}" disabled="{{uploading}}">
        {{L.profile.login}}
      </button>
      <view class="login-tip">{{L.profile.loginTip}}</view>
    </view>

    <!-- 已登录：点头像只换头像，点昵称只用微信昵称（各自独立授权，老行为不变） -->
    <view wx:else class="profile-row">
      <!-- open-type="chooseAvatar" 调起微信头像选择器 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar avatar-empty">
          <image class="avatar-ph" src="/images/tabbar/avatar.png" mode="aspectFill" />
        </view>
      </button>

      <view class="info-col">
        <view class="nick-label">{{L.profile.nickname}}</view>
        <!-- type="nickname" 调起微信昵称选择器。focus 只在登录流程里置 true，
             用来自动弹出键盘上的「使用微信昵称」，平时保持 false 不打扰用户。 -->
        <input class="nick-input" type="nickname" value="{{nickname}}" placeholder="{{L.profile.nicknamePlaceholder}}"
               focus="{{nickFocus}}" bindinput="onNicknameInput" bindblur="onNicknameInput" maxlength="20" />
        <view class="tip">{{loginStep === 'nick' ? L.profile.loginNickTip : L.profile.nicknameTip}}</view>
      </view>
    </view>

    <!-- 没登录时没什么可存的，保存按钮不出现 -->
    <button wx:if="{{loggedIn}}" class="btn-primary save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving || !dirty}}">
      {{L.profile.saveProfile}}
    </button>
  </view>

  <!-- 个人信息表入口 -->
  <view class="card info-entry-card" bindtap="openInfo">
    <view class="info-entry-left">
      <view class="info-entry-title">{{L.profile.infoEntryTitle}}</view>
      <view class="info-entry-sub">
        {{L.profile.infoEntrySub}}
      </view>
    </view>
    <view class="info-entry-right">
      <text class="info-entry-state">{{ hasInfo ? L.profile.filled : L.profile.fill }}</text>
      <text class="info-entry-arrow">›</text>
    </view>
  </view>

  <!-- 化妆品管理入口：仅化妆师视图可见。角标只读 storage 缓存，
       不为了这个数字发云函数调用（见 profile.js 的 refreshCosmeticBadge）。
       这一整块属于化妆师后台，**不参与翻译**，保持中文。 -->
  <view wx:if="{{isAdmin}}" class="card info-entry-card" bindtap="openCosmetics">
    <view class="info-entry-left">
      <view class="info-entry-title">化妆品管理</view>
      <view class="info-entry-sub">种类、色号、效期与到期提醒</view>
    </view>
    <view class="info-entry-right">
      <text class="info-entry-state" style="{{cosmeticStateColor}}">{{cosmeticState}}</text>
      <text class="info-entry-arrow">›</text>
    </view>
  </view>

  <!-- 双端切换入口：化妆师和顾客看到的是同一个位置、文案相反 -->
  <view wx:if="{{!isAdmin}}" class="admin-entry" bindtap="goAdmin">
    <text>{{L.profile.artistEntry}}</text>
  </view>
  <view wx:else class="admin-entry" bindtap="goCustomer">
    <text>{{L.profile.customerEntry}}</text>
  </view>

</view>

<!-- 个人信息表：组件形式，个人中心与首页预约前共用 -->
<info-form
  id="infoForm"
  visible="{{showInfo}}"
  info="{{info}}"
  nickname="{{nickname}}"
  title="{{L.info.title}}"
  submit-text="{{L.common.save}}"
  lang="{{lang}}"
  bind:close="closeInfo"
  bind:save="onSaveInfo"
/>
