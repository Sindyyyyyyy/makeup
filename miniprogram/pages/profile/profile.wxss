/* pages/profile/profile.wxss - 个人中心 (温柔少女风) */
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 资料卡 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #C95B7C;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 头像选择器按钮：去掉 button 默认边框与背景 */
.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  flex-shrink: 0;
}
.avatar-btn::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  display: block;
}
.avatar-empty {
  background: linear-gradient(135deg, #FFF0F4 0%, #FFE4EC 100%);
  border: 2rpx solid #FFB6C8;
  overflow: hidden;
}
.avatar-ph {
  width: 100%;
  height: 100%;
}

.info-col {
  flex: 1;
  min-width: 0;
}
.nick-label {
  font-size: 24rpx;
  color: #B89C8A;
  margin-bottom: 8rpx;
}
.nick-input {
  background: #FFF5F7;
  border: 2rpx solid #FFE0E8;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  height: auto;
}
.tip {
  font-size: 22rpx;
  color: #B0A0A0;
  margin-top: 12rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #C95B7C 0%, #E895A8 100%);
  color: #FFFFFF !important;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}
.btn-primary[disabled] {
  opacity: 0.6;
  color: #FFFFFF !important;
}
/* 顶部“保存资料”按钮的上边距只作用于它自己，
   不要挂在 .btn-primary 上——弹窗里的保存按钮会继承，两颗按钮就对不齐了 */
.save-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* 个人信息表入口 */
.info-entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}
.info-entry-left {
  flex: 1;
  min-width: 0;
}
.info-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
}
.info-entry-sub {
  font-size: 22rpx;
  color: #B0A0A0;
  margin-top: 8rpx;
}
.info-entry-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-left: 16rpx;
}
.info-entry-state {
  font-size: 26rpx;
  color: #C95B7C;
}
.info-entry-arrow {
  font-size: 36rpx;
  color: #C9B8C0;
  margin-left: 8rpx;
  line-height: 1;
}

/* 化妆师入口 */
.admin-entry {
  text-align: center;
  margin-top: 40rpx;
  color: #B89C8A;
  font-size: 24rpx;
  padding: 16rpx;
  letter-spacing: 4rpx;
}